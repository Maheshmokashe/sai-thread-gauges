# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enquiry email delivery (console output locally; Resend HTTPS API in production)
ENQUIRY_NOTIFY_EMAIL=saithreadgauges@gmail.com
