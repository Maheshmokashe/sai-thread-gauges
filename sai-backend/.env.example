# Local dev works with NO .env at all (SQLite + console email).
# Set these to move to Postgres / real email / production.

SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Postgres (leave unset to use SQLite locally)
# DATABASE_URL=postgres://sai_user:sai_password@localhost:5432/sai_db

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enquiry email delivery (defaults to console printing in dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=saithreadgauges@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
ENQUIRY_NOTIFY_EMAIL=saithreadgauges@gmail.com
